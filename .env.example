JWT_SECRET=change-this-jwt-secret
LISTENER_API_KEY=change-this-long-listener-key

# Cambie MAIL_ENABLED a true solamente cuando las credenciales SMTP estén configuradas.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@example.com
INSTITUTION_NAME=Institución Educativa

# Separar correos con coma. Mientras exista esta variable, ningún correo real de representante se usa.
MAIL_TEST_RECIPIENTS=prueba1@example.com,prueba2@example.com
