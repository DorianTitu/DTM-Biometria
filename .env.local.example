# Copie este archivo como .env antes de levantar la estación local.
# No suba el archivo .env real al repositorio.

# Clave interna usada por el listener local.
LISTENER_API_KEY=genere-una-clave-local-larga

# API key dmt_... creada en el panel del servidor VPS.
CLOUD_API_KEY=dmt_reemplace_con_la_clave_del_vps

# URL base del VPS (sin /api/attendance/events).
CLOUD_API_URL=https://dmt-security.systems
